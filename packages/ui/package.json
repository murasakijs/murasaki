{
  "name": "@murasakijs/ui",
  "version": "0.3.0",
  "description": "React Aria-based component library for the Murasaki desktop framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasakijs/murasaki.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "styles.css",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react-aria-components": "^1.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
