{
  "name": "@murasakijs/ui",
  "version": "0.2.1",
  "description": "shadcn/ui-style component library for the murasaki desktop framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasakijs/murasaki.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "dist",
    "styles.css",
    "tailwind-preset.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
