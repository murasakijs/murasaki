{
  "name": "murasaki",
  "version": "0.55.7",
  "description": "Next.js DX for desktop apps. React 19 + Vite + Rust-native.",
  "keywords": [
    "desktop",
    "framework",
    "nextjs",
    "react",
    "vite",
    "tauri-alternative",
    "electron-alternative"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasakijs/murasaki.git",
    "directory": "packages/murasaki"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "murasaki": "./bin/murasaki.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "default": "./dist/vite-plugin/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "default": "./dist/main/index.js"
    },
    "./main-client": {
      "types": "./dist/main-client/index.d.ts",
      "default": "./dist/main-client/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "capabilities.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "pnpm build && node --test test/*.test.mjs",
    "api:report": "pnpm build && api-extractor run --local --config api-extractor.json && api-extractor run --local --config api-extractor.main.json && api-extractor run --local --config api-extractor.main-client.json && api-extractor run --local --config api-extractor.native.json && api-extractor run --local --config api-extractor.vite-plugin.json",
    "api:check": "pnpm build && api-extractor run --config api-extractor.json && api-extractor run --config api-extractor.main.json && api-extractor run --config api-extractor.main-client.json && api-extractor run --config api-extractor.native.json && api-extractor run --config api-extractor.vite-plugin.json",
    "prepack": "node scripts/package-readme.mjs sync",
    "postpack": "node scripts/package-readme.mjs clean"
  },
  "dependencies": {
    "@murasakijs/native": "workspace:^",
    "@murasakijs/ui": "workspace:^",
    "@vitejs/plugin-react": "^5.0.4",
    "openpgp": "6.3.1",
    "picocolors": "^1.1.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "resedit": "^3.0.2",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.11",
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
