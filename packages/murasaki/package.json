{
  "name": "murasaki",
  "version": "0.47.1",
  "description": "Next.js DX for desktop apps. React 19 + Vite + Rust-native.",
  "keywords": [
    "desktop",
    "framework",
    "nextjs",
    "react",
    "vite",
    "tauri-alternative",
    "electron-alternative"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasakijs/murasaki.git",
    "directory": "packages/murasaki"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bin": {
    "murasaki": "./bin/murasaki.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin/index.d.ts",
      "default": "./dist/vite-plugin/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@murasakijs/native": "workspace:^",
    "@murasakijs/ui": "workspace:^",
    "vite": "^7.3.6",
    "@vitejs/plugin-react": "^5.0.4",
    "picocolors": "^1.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "resedit": "^3.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pngjs": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
