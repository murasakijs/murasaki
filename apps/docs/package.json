{
  "name": "murasaki-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/gen-doc-dates.mjs && node scripts/gen-changelog.mjs",
    "build": "next build",
    "predev": "node scripts/gen-doc-dates.mjs && node scripts/gen-changelog.mjs",
    "dev": "next dev",
    "docs:dates": "node scripts/gen-doc-dates.mjs",
    "docs:changelog": "node scripts/gen-changelog.mjs",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@murasakijs/ui": "workspace:*",
    "@orama/tokenizers": "^3.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.2.0",
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.10",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "matter-js": "^0.20.0",
    "motion": "^13.3.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
