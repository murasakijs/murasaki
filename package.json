{
  "name": "murasaki",
  "version": "0.2.0",
  "description": "The desktop framework for Next.js developers. Node-powered. WebView-thin. No Rust. No Chromium.",
  "keywords": [
    "desktop",
    "framework",
    "nextjs",
    "react",
    "node",
    "webview",
    "tauri-alternative",
    "electron-alternative"
  ],
  "homepage": "https://github.com/murasakijs/murasaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murasakijs/murasaki.git"
  },
  "bugs": {
    "url": "https://github.com/murasakijs/murasaki/issues"
  },
  "license": "MIT",
  "author": "ichi",
  "type": "module",
  "bin": {
    "murasaki": "./bin/murasaki.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsx": {
      "types": "./src/jsx/index.ts",
      "default": "./src/jsx/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx/jsx-runtime.ts",
      "default": "./src/jsx/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx/jsx-dev-runtime.ts",
      "default": "./src/jsx/jsx-dev-runtime.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example:app-router": "cd examples/app-router && pnpm dev",
    "check": "biome check",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write"
  },
  "dependencies": {
    "@webviewjs/webview": "^0.3.2",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
